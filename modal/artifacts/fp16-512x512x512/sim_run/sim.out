-gpgpu_ptx_save_converted_ptxplus                    0 # Saved converted ptxplus to a file
-gpgpu_occupancy_sm_number                   80 # The SM number to pass to ptxas when getting register usage for computing GPU occupancy. This parameter is required in the config.
